# Never commit real values. Use your secret manager in deployed environments.
NEXUS_TRUSTED_CIDRS=127.0.0.1/32
NEXUS_OIDC_ISSUER=https://YOUR-OIDC-ISSUER/
NEXUS_OIDC_AUDIENCE=nexus-v12
NEXUS_OIDC_JWKS_URL=https://YOUR-OIDC-ISSUER/.well-known/jwks.json
NEXUS_AUDIT_DATABASE_URL=postgresql://nexus:CHANGE_ME@postgres:5432/nexus
NEXUS_PROVIDER_URL=https://YOUR-APPROVED-PROVIDER.example/v1/search
NEXUS_PROVIDER_ALLOWED_HOSTS=YOUR-APPROVED-PROVIDER.example
NEXUS_PROVIDER_TOKEN=CHANGE_ME
NEXUS_RATE_WINDOW_SECONDS=60
NEXUS_RATE_LIMIT_PER_MINUTE=30
NEXUS_BURST_LIMIT=8
NEXUS_MAX_IMAGE_BYTES=10485760
