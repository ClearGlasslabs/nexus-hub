FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN useradd --create-home --uid 10001 nexus
COPY nexus_v12/requirements.txt /app/nexus_v12/requirements.txt
RUN pip install --no-cache-dir -r /app/nexus_v12/requirements.txt
COPY nexus_v12 /app/nexus_v12
USER 10001
EXPOSE 8080
CMD ["uvicorn", "nexus_v12.api:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--forwarded-allow-ips", ""]
